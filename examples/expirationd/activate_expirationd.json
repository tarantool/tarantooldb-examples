{
    "query":"mutation editTopology($replicasets: [EditReplicasetInput!], $servers: [EditServerInput!]) { cluster { edit_topology(replicasets: $replicasets, servers: $servers) { servers { uuid } } }}",
    "variables": {
        "replicasets": [
            {
                "uuid": "aaaaaaaa-0000-4000-b001-000000000000",
                "roles": [
                    "crud-router",
                    "space-explorer"
                ]
            },
            {
                "uuid": "aaaaaaaa-0000-4000-b010-000000000000",
                "roles": [
                    "crud-storage",
                    "space-explorer",
                    "expirationd"
                ]
            },
            {
                "uuid": "aaaaaaaa-0000-4000-b010-000000000001",
                "roles": [
                    "crud-storage",
                    "space-explorer",
                    "expirationd"
                ]
            }
        ]
    }
}
